@"
# ============================================================
# NordTafl — Plantilla de variables de entorno
# Copia este archivo a .env y rellena los valores
# ============================================================

DB_URL=jdbc:postgresql://localhost:5432/nordtafl
DB_USER=postgres
DB_PASSWORD=cambia-esta-password
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
CLOUDINARY_CLOUD_NAME=cambia-este-cloud-name
CLOUDINARY_API_KEY=cambia-esta-api-key
CLOUDINARY_API_SECRET=cambia-este-api-secret
REDIS_URL=redis://localhost:6379

JWT_SECRET=cambia-este-secret-minimo-32-caracteres
JWT_ACCESS_EXPIRATION=900
JWT_REFRESH_EXPIRATION=604800

WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=NordTafl
WEBAUTHN_ORIGIN=http://localhost:8080

APP_ENV=dev
PORT=8080

ALERTS_EMAIL_ENABLED=false
ALERTS_EMAIL_TO=tu-correo@gmail.com
ALERTS_TELEGRAM_ENABLED=false
ALERTS_TELEGRAM_BOT_TOKEN=
ALERTS_TELEGRAM_CHAT_ID=
"@ | Out-File -FilePath ".env.example" -Encoding UTF8

Write-Host ".env.example creado" -ForegroundColor Green

BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=cambia-esta-user
BREVO_SMTP_PASSWORD=cambia-esta-password
BREVO_FROM_EMAIL=noreply@nordtafl.app